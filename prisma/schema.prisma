// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  INSTRUCTOR
  ADMIN
  BLOG_MANAGER
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  IN_PROGRESS
  COMPLETED
}

model User {
  id              String   @id @default(cuid())
  fullName        String?
  email           String?  @unique
  passwordHash    String?
  role            Role     @default(CANDIDATE)
  phone           String?
  profileImageUrl String?
  isVerified      Boolean  @default(false)
  mfaEnabled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments      Enrollment[]
  certificates     Certificate[]
  blogPosts        BlogPost[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
}

model Certification {
  id             String    @id @default(cuid())
  title          String
  level          String
  description    String
  price          Float     @default(0.0)
  examDate       DateTime?
  durationWeeks  Int?
  syllabusFileId String?
  passRate       Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enrollments   Enrollment[]
  certificates  Certificate[]
  syllabusFiles SyllabusFile[]
  translations  CertificationTranslation[]
  messages      Message[]
}

model CertificationTranslation {
  id              String @id @default(cuid())
  certificationId String
  locale          String
  title           String
  description     String

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([certificationId, locale])
}

model Enrollment {
  id                   String           @id @default(cuid())
  userId               String
  certificationId      String
  status               EnrollmentStatus @default(PENDING)
  progressPercent      Float            @default(0.0)
  paymentScreenshot    String?
  enrolledAt           DateTime         @default(now())
  completedAt          DateTime?
  completedSyllabusIds String[]         @default([])

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([userId, certificationId])
}

model Certificate {
  id                String   @id @default(cuid())
  certificateId     String   @unique @default(uuid())
  certificateNumber String   @unique
  userId            String
  certificationId   String
  grade             String?
  pdfUrl            String?
  issuedAt          DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
}

model Message {
  id              String   @id @default(cuid())
  senderId        String
  recipientId     String?
  certificationId String?
  subject         String
  body            String
  isRead          Boolean  @default(false)
  parentId        String?
  createdAt       DateTime @default(now())

  sender        User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User?          @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  certification Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  parent        Message?       @relation("Replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Message[]      @relation("Replies")
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  authorId        String
  category        String
  tags            String[]
  isFeatured      Boolean   @default(false)
  readTimeMinutes Int       @default(0)
  coverImageUrl   String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author       User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  translations BlogPostTranslation[]
}

model BlogPostTranslation {
  id         String @id @default(cuid())
  blogPostId String
  locale     String
  title      String
  body       String

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
}

model SyllabusFile {
  id              String   @id @default(cuid())
  certificationId String
  fileName        String
  fileUrl         String
  fileSizeKb      Int
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
}
